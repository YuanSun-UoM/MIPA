%--------------------------------------------------------------------------
% MIPA configuration parameters
%--------------------------------------------------------------------------
function cfg = config_MIPA()
    
    % Change with the name of the NetCDF file inside the folder data/input

    cfg.filename = 'demo_lidar'; 
    
    % Specify the name of the NetCDF variable containing the input signal.
    % For user datasets this depends on the original product, whereas the
    % demonstration NetCDF files always use the standardized variable
    % 'input_dataset'.

    cfg.variable_filename = 'input_dataset';
    
    % Specify the type of measurement
    cfg.measurement_tag = 'lidar'; % or 'ceilometer'.

    % Flag for displaying figures while running the code.     
    cfg.figures_disp_flag = 'false'; % Set to 'true' to display figures
    
    % Flag for saving intermediate and final ABL evolution figures  
    cfg.figures_save_flag = 'false'; % Set to 'true' to save figures
    
    % Fallback original vertical resolution; overwritten when available
    % from the NetCDF

    cfg.spatial_resolution = 3.75; % for lidar------------------------- [m]
    % cfg.spatial_resolution = 15; % for ceilometer-------------------- [m]

    if strcmp(cfg.measurement_tag, 'lidar')

        cfg.des_res = 22.5; % ------- Desired lidar degraded resolution [m]
    
    else
        
        cfg.des_res = 70; % ---- Desired ceilometer degraded resolution [m]
    
    end

    % Reciprocal of the vertical down-sampling factor
    cfg.spatial_red_factor = 1/round(cfg.des_res/cfg.spatial_resolution);
    
    cfg.mov_avg_tag = 'box'; % ---------------------- Moving average kernel 
        % Start/stop analysis 
    cfg.start_analysis_meters = 200; % -------------- Lower analysis limit [m]  
    cfg.stop_analysis_meters  = 7000; % ------------------- Stop height [m]  
        
    % Radiometric normalization
    cfg.p_low = 0; % ------------------------------- Lower-limit percentile
    cfg.p_high = 99; % ----------------------------- Upper-limit percentile

    % Pre-processing ------------------------------------------------------
    cfg.flag_preprocessing_mf = 1; % ----------------- 0: No Pre-processing
                                   % ----------------- 1: Pre-processing 
                                   % -----------------    using mean of 
                                   % -----------------    half gradients

    cfg.line_length = 3; % ----------------------- Length line SE for 
                         % ----------------------- morphological operations  
    
    cfg.flag_morph_grad = 0; % ---------- 0: No Morphological gradient (MG) 
                             % ---------- 1: Gradient; 
                             % ---------- 2: Half gradient.
    
    cfg.starting_angle_morph_grad = 0; % --- Lower-bound angle for MG [deg]
    cfg.stopping_angle_morph_grad = 0; % --- Upper-bound angle for MG [deg]

    % Edge detection ------------------------------------------------------

    cfg.flag_edge_detector = 1; % ----------------------------- 1: Canny 
                                % ----------------------------- 2: Sobel
                                % ----------------------------- 3: Prewitt
                                % ----------------------------- 4: WCT

    % MF post-processing ------------------------------------------------

    cfg.flag_postprocessing = 1; % ------------- 0: No post-processing
                                 % ------------- 1: Post-Processing with MF

    cfg.line_postprocessing = 4; % ------------- LP line filter for 
                                 % ------------- detecting quick variations
                                 % ------------- of the ABL
    
    cfg.max_angle_postprocessing = 66; % ------- in deg.
    
    % Object analysis -----------------------------------------------------
    
    cfg.delta_0 = 60;  % Euclidean-distance threshold in raw range bins

    cfg.th_ext_abl = round(cfg.delta_0*cfg.spatial_red_factor); % ---
                        % Euclidean-distance threshold expressed in down-sampled range bins  
                              
    cfg.w_ext_abl = 40;  % ----------- Temporal window dimension for ABLH extraction
    cfg.perc_null_abl_pxls = 0.2; % ----------- Percentage null ABLH pixels

    cfg.thr_dim_objs = 300;  % Maximum object area, in pixels, for which
                             % the consistency checks are applied
     
    cfg.base_variation = 100;  % Maximum vertical difference between neighboring objects,
                               % expressed in raw range bins

    % Maximum variation between two adjacent objects
    cfg.thr_variation = round(cfg.base_variation*cfg.spatial_red_factor); 
    % Corresponding threshold in down-sampled range bins

                           

    cfg.w_obj_check = 120;  % Half-width of the neighboring-object search 
                            % window, in profiles
    cfg.w_time_min = 0; % Minimum temporal extent of an object, in profiles
    cfg.num_Layers = 1; % ------------------ Number of layers to be printed


    % Fallback value; overwritten by surface_altitude read from the NetCDF
    cfg.surface_altitude = 760; % measurement site altitude above sea level [m]


end
% --------


   

    


  